[
  {
    "label": "Flutter: run interactively",
    "command": "flutter",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Flutter: list devices",
    "command": "flutter",
    "args": ["devices"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Flutter: get packages",
    "command": "flutter",
    "args": ["pub", "get"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Flutter: analyze",
    "command": "flutter",
    "args": ["analyze"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Dart: format",
    "command": "dart",
    "args": ["format", "."],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Flutter: test",
    "command": "flutter",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
